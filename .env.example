# Copy to .env and fill in. Load it with your host's env settings or `set -a; . ./.env; set +a`.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# twilio | telegram | console
CHANNEL=telegram

# Who gets the weekly plan and is allowed to reply (comma-separated).
# Twilio: phone numbers like +15551234567. Telegram: chat ids (message your bot, then see README).
RECIPIENTS=

# Public URL of this server (for Twilio signature checks and the Telegram webhook)
PUBLIC_BASE_URL=https://your-app.example.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=pick-a-long-random-string

# Schedule (defaults: Saturday 7:00pm Pacific)
TIMEZONE=America/Los_Angeles
SEND_WEEKDAY=5
SEND_HOUR=19
SEND_MINUTE=0
CRON_SECRET=another-long-random-string
